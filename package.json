{
  "name": "@cowprotocol/app-data",
  "version": "3.3.0",
  "description": "CoW Protocol AppData schema definitions",
  "type": "module",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.module.mjs",
      "default": "./dist/index.modern.mjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.module.js",
  "unpkg": "./dist/index.umd.js",
  "types": "dist/index.d.ts",
  "files": [
    "/dist",
    "/schemas"
  ],
  "scripts": {
    "clean": "rimraf dist && rimraf src/generatedTypes && rimraf schemas",
    "compile": "tsx src/scripts/compile.ts",
    "build": "yarn clean && yarn compile && microbundle -f modern,esm,cjs",
    "test": "node --import tsx --test \"src/api/**.{spec,test}.ts\"",
    "prepare": "yarn build && yarn test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cowprotocol/app-data.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cowprotocol/app-data/issues"
  },
  "homepage": "https://github.com/cowprotocol/app-data#readme",
  "devDependencies": {
    "@types/node": "^24.2.1",
    "@types/semver-sort": "^0.0.5",
    "ethers": "^6.15.0",
    "json-schema-ref-parser": "^9.0.9",
    "json-schema-to-typescript": "^15.0.4",
    "microbundle": "^0.15.1",
    "nock": "^14.0.10",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "semver-sort": "^1.0.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ipfs-only-hash": "^4.0.0",
    "json-stringify-deterministic": "^1.0.12",
    "multiformats": "^13.4.0"
  }
}
